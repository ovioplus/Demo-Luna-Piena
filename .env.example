# ---------------------------------------------------------------------------
# Luna Piena.
#
# Only the contact form needs anything here. The rest of the site is static
# content committed to the repo, so it builds and serves with none of this set.
# ---------------------------------------------------------------------------

# Resend. Same account as the other OvioPlus projects, separate API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The verified sender. Note the .com: OvioPlus serves the web from .ai
# (ovioplus.ai, app.ovioplus.ai) but sends mail from .com, and ovioplus.com is
# the domain actually verified in Resend. Sending from .ai fails with a 403.
#
# the restaurant's own domain is NOT verified yet, so mail goes out from OvioPlus and the
# visitor's address is set as reply-to. Once the client's domain is verified,
# change this line and nothing else.
CONTACT_FROM_EMAIL="Luna Piena <no-reply@ovioplus.com>"

# Where the restaurant actually reads its mail.
CONTACT_TO_EMAIL=info@lunapiena.it

# Canonical URL, used for metadata and structured data.
NEXT_PUBLIC_SITE_URL=https://lunapiena-demo.vercel.app

# ---------------------------------------------------------------------------
# Phase 2: the dashboard.
#
# Leave all of this unset and the site still builds and serves: the menu and
# the hours fall back to the committed seed files and the dashboard reports
# itself as not configured. Set it and the dashboard takes over.
# ---------------------------------------------------------------------------

# Neon, its own project, not the OvioPlus one. DATABASE_URL is the pooled
# endpoint the app uses; DIRECT_URL is the un-pooled one for migrations.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/lunapiena?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/lunapiena?sslmode=require

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Who may sign in to the dashboard. Comma separated, case insensitive.
# Empty means nobody, which is the correct behaviour for a misconfigured deploy.
OWNER_EMAILS=owner@example.com
